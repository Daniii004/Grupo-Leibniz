@startuml

skinparam packageStyle rectangle

' --- ACTORES ---
actor "Usuario" as user
actor "Administrador" as admin
actor "Superadministrador" as superadmin
actor "Cliente API" as api
actor "Sistema" as system

' Herencia de permisos: Admin puede hacer lo de User, Superadmin puede hacer lo de Admin
user <|-- admin
admin <|-- superadmin

rectangle "Sistema interno de facturación y cobros de Turbine" {

    package "Bloque 7: Operativa diaria, informes, configuración y API" {

        ' Operativa diaria (FR28)
        usecase "Consultar tareas pendientes" as tareas
        usecase "Buscar clientes y facturas" as buscar

        ' Operaciones masivas (FR29)
        usecase "Ejecutar acciones masivas" as accionesMasivas
        usecase "Transferir cliente\n(del Bloque 1)" as transferirExt

        ' Panel e informes (FR30)
        usecase "Consultar panel financiero" as panel
        usecase "Desglosar métricas (Drill-down)" as drilldown
        usecase "Configurar objetivos de facturación" as objetivos
        usecase "Generar y exportar informes/paquetes" as informes
        usecase "Programar informes periódicos" as programar

        ' Configuración de empresa (FR31)
        usecase "Modificar datos fiscales" as datosFiscales
        usecase "Configurar parámetros globales" as paramsGlobales

        ' API (FR32)
        usecase "Consultar deudas vía API" as consultarDeudaAPI

        ' Procesos automáticos (FR33)
        usecase "Monitorizar estado del sistema" as monitorizar
        usecase "Ejecutar procesos en segundo plano" as segundoPlano
    }
}

' --- RELACIONES ---

' Usuario
user -- tareas
user -- buscar

' Administrador
admin -- accionesMasivas
accionesMasivas ..> transferirExt : <<include>>

admin -- panel
panel ..> drilldown : <<extends>>
admin -- objetivos
admin -- informes
admin -- programar

admin -- datosFiscales
admin -- consultarDeudaAPI
admin -- monitorizar

' Superadministrador
superadmin -- paramsGlobales

' Actores no humanos
api -- consultarDeudaAPI
system -- segundoPlano

@enduml