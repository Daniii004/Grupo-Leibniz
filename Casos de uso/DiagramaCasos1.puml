@startuml
left to right direction
skinparam packageStyle rectangle

' --- ACTORES ---
actor "Usuario" as Usuario
actor "Administrador" as Admin
actor "Superadministrador" as SuperAdmin
actor "Sistema" as Sistema <<Sistema>>
actor "Temporizador\n(Scheduler)" as Timer <<Sistema>>

' Herencia de permisos: el administrador puede hacer lo del usuario
' y el superadministrador, lo del administrador
Usuario <|-- Admin
Admin <|-- SuperAdmin

rectangle "Sistema interno de facturación y cobros de Turbine" {

    package "Bloque 1: Gestión de usuarios, roles y asignaciones" {

        ' Cuentas de usuario (FR1)
        usecase "CU-101\nRegistrar / invitar una cuenta\nde usuario (sin autorregistro)" as CU101
        usecase "CU-102\nRestablecer contraseña" as CU102
        usecase "CU-103\nDesactivar cuenta de usuario" as CU103
        usecase "CU-104\nCerrar sesiones activas\nal desactivar la cuenta" as CU104
        usecase "CU-105\nCerrar sesión por inactividad" as CU105

        ' Asignación de clientes (FR2)
        usecase "CU-106\nAsignar clientes a usuarios" as CU106
        usecase "CU-107\nTransferir cliente a otro usuario" as CU107
        usecase "CU-108\nCeder cliente de forma temporal" as CU108
        usecase "CU-109\nDevolver cliente al\nresponsable inicial" as CU109

        ' Autorización por roles (FR3)
        usecase "CU-110\nAplicar autorización\ncentralizada por roles" as CU110
        usecase "CU-111\nAcceder a los clientes asignados" as CU111
        usecase "CU-112\nBloquear acciones no permitidas\ndel usuario operativo" as CU112
        usecase "CU-113\nConfigurar el sistema globalmente" as CU113
    }
}

' --- RELACIONES ENTRE CASOS DE USO ---
CU103 ..> CU104 : <<include>>
CU107 ..> CU106 : <<include>>

' Extensiones (la flecha parte del caso que extiende)
CU109 ..> CU108 : <<extend>>\n[llega la fecha de fin]

' --- ASOCIACIONES ACTOR - CASO DE USO ---

' Usuario
Usuario -- CU102
Usuario -- CU111

' Administrador
Admin -- CU101
Admin -- CU103
Admin -- CU106
Admin -- CU107
Admin -- CU108

' Superadministrador
SuperAdmin -- CU113

' Procesos automáticos
Sistema -- CU104
Sistema -- CU110
Sistema -- CU112
Timer -- CU105
Timer -- CU109

@enduml
