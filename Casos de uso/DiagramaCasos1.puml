@startuml
skinparam packageStyle rectangle

' --- ACTORES ---
actor "Usuario" as Usuario
actor "Administrador" as Admin
actor "Superadministrador" as SuperAdmin
actor "Sistema" as Sistema <<Sistema>>
actor "Temporizador\n(Scheduler)" as Timer <<Sistema>>

' Herencia de permisos: el administrador puede hacer lo del usuario
' y el superadministrador, lo del administrador
Usuario <|-- Admin
Admin <|-- SuperAdmin

rectangle "Sistema interno de facturación y cobros de Turbine" {

    package "Bloque 1: Gestión de usuarios, roles y asignaciones" {

        ' Cuentas de usuario (FR1)
        usecase "Registrar / invitar una cuenta\nde usuario (sin autorregistro)" as CU101
        usecase "Restablecer contraseña" as CU102
        usecase "Desactivar cuenta de usuario" as CU103
        usecase "Cerrar sesiones activas\nal desactivar la cuenta" as CU104
        usecase "Cerrar sesión por inactividad" as CU105

        ' Asignación de clientes (FR2)
        usecase "Asignar clientes a usuarios" as CU106
        usecase "Transferir cliente a otro usuario" as CU107
        usecase "Ceder cliente de forma temporal" as CU108
        usecase "Devolver cliente al\nresponsable inicial" as CU109

        ' Autorización por roles (FR3)
        usecase "Aplicar autorización\ncentralizada por roles" as CU110
        usecase "Acceder a los clientes asignados" as CU111
        usecase "Bloquear acciones no permitidas\ndel usuario operativo" as CU112
        usecase "Configurar el sistema globalmente" as CU113
    }
}

' --- RELACIONES ENTRE CASOS DE USO ---
CU103 ..> CU104 : <<include>>
CU107 ..> CU106 : <<include>>

' Extensiones (la flecha parte del caso que extiende)
CU109 ..> CU108 : <<extend>>\n[llega la fecha de fin]

' --- ASOCIACIONES ACTOR - CASO DE USO ---

' Usuario
Usuario -- CU102
Usuario -- CU111

' Administrador
Admin -- CU101
Admin -- CU103
Admin -- CU106
Admin -- CU107
Admin -- CU108

' Superadministrador
SuperAdmin -- CU113

' Procesos automáticos
Sistema -- CU104
Sistema -- CU110
Sistema -- CU112
Timer -- CU105
Timer -- CU109

@enduml
