@startuml
left to right direction
skinparam packageStyle rectangle

' --- ACTORES ---
actor "Usuario" as Usuario
actor "Administrador" as Admin
actor "Superadministrador" as SuperAdmin

' Herencia de permisos: el administrador puede hacer lo del usuario
' y el superadministrador, lo del administrador
Usuario <|-- Admin
Admin <|-- SuperAdmin

rectangle "Sistema interno de facturación y cobros de Turbine" {

    package "Bloque 2: Gestión de clientes y contactos" {

        ' Clientes (FR4)
        usecase "CU-201\nDar de alta un cliente" as CU201
        usecase "CU-202\nModificar la ficha del cliente" as CU202

        ' Personas de contacto (FR5)
        usecase "CU-203\nGestionar personas de contacto" as CU203
        usecase "CU-204\nDesactivar un contacto\nconservando su historial" as CU204
        usecase "CU-205\nAvisar del único contacto\nde facturación" as CU205

        ' Ciclo de vida (FR6)
        usecase "CU-206\nGestionar el estado del cliente" as CU206
        usecase "CU-207\nFusionar clientes duplicados" as CU207

        ' Importación (FR7)
        usecase "CU-208\nImportar clientes desde CSV" as CU208

        ' Historial (FR8)
        usecase "CU-209\nConsultar el historial del cliente" as CU209
    }
}

' --- RELACIONES ENTRE CASOS DE USO ---

' Extensiones (la flecha parte del caso que extiende)
CU205 ..> CU204 : <<extend>>\n[es el único contacto\nde facturación]

' --- ASOCIACIONES ACTOR - CASO DE USO ---

' Usuario (sobre sus clientes asignados)
Usuario -- CU202
Usuario -- CU203
Usuario -- CU209

' Administrador
Admin -- CU201
Admin -- CU204
Admin -- CU206
Admin -- CU207
Admin -- CU208

@enduml
