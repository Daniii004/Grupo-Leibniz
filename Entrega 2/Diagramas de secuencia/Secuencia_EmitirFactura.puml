@startuml Secuencia_EmitirFactura
title Diagrama de secuencia: Emitir factura puntual

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "actor : Usuario" as User
participant "sf : ServicioFacturacion" as SF <<control>>
participant "sAuth : ServicioAutorizacion" as SAuth <<control>>
participant "p : PeriodoAdministrativo" as Periodo
participant "f : Factura" as Factura
participant "serie : SerieFacturacion" as Serie
participant "sAprob : ServicioAprobaciones" as SAprob <<control>>
participant "sCom : ServicioComunicaciones" as SCom <<control>>
participant "prov : ProveedorMensajeria" as Prov <<interface>>
participant "sInc : ServicioIncidencias" as SInc <<control>>
participant "sNotif : ServicioNotificaciones" as SNotif <<control>>
participant "sAud : ServicioAuditoria" as SAud <<control>>

User -> SF : emitir(actor, f)
activate SF

' 1. Autorización centralizada por permiso (lanza excepción si falla)
SF -> SAuth : autorizar(actor, "EMITIR_FACTURA", f.cliente)
activate SAuth
SAuth --> SF
deactivate SAuth

' 2. Comprobación del periodo administrativo
SF -> Periodo : contiene(fechaActual)
activate Periodo
Periodo --> SF : incluido : boolean
deactivate Periodo

alt periodo cerrado (p.cerrado == true)
    SF --> User : Error("No se puede emitir en un periodo cerrado")

else periodo abierto
    ' 3. Validación de datos de la factura y del cliente
    SF -> Factura : validar()
    activate Factura
    Factura --> SF : errores : List<String>
    deactivate Factura

    alt errores está vacía
        SF -> Factura : requiereAprobacion()
        activate Factura
        Factura --> SF : requiere : boolean
        deactivate Factura

        alt requiere == true (umbral de importe/descuento o condiciones especiales)
            SF -> SAprob : solicitar(actor, f, tipoOp, motivo)
            activate SAprob
            create participant "sol : SolicitudAprobacion" as Sol
            SAprob -> Sol : <<create>>(f, actor, tipoOp, motivo)
            SAprob -> SNotif : notificar(aprobador, "APROBACION_PENDIENTE", mensaje)
            activate SNotif
            SNotif --> SAprob : notif : Notificacion
            deactivate SNotif
            SAprob --> SF : sol : SolicitudAprobacion
            deactivate SAprob

            SF -> SAud : registrar(actor, "SOLICITAR_APROBACION", "Factura", f.id, detalle)
            activate SAud
            SAud --> SF : registro : RegistroAuditoria
            deactivate SAud

            SF --> User : Factura en estado PENDIENTE_APROBACION

        else requiere == false (emisión directa)
            SF -> Factura : emitir(serie)
            activate Factura
            Factura -> Serie : siguienteNumero()
            activate Serie
            Serie --> Factura : numero : String
            deactivate Serie
            Factura --> SF
            deactivate Factura

            SF -> Factura : generarPDF()
            activate Factura
            Factura --> SF : pdf : DocumentoPDF
            deactivate Factura

            SF -> SCom : enviarFactura(f)
            activate SCom
            note right of Prov
              Implementación activa según configuración:
              CorreoSMTP, WhatsAppAPI o MensajeriaSimulada
            end note
            SCom -> Prov : enviar(envio)
            activate Prov
            Prov --> SCom : enviado : boolean
            deactivate Prov

            alt enviado == true
                note right of SCom
                  Envio -> ENVIADO
                  Factura -> ENVIADA
                end note
            else enviado == false (fallo / rebote de entrega)
                SCom -> SCom : registrarRebote(envio)
                activate SCom
                SCom -> SInc : crearPorRebote(envio)
                activate SInc
                SInc -> SNotif : notificar(responsable, "REBOTE_ENVIO", mensaje)
                activate SNotif
                SNotif --> SInc : notif : Notificacion
                deactivate SNotif
                SInc --> SCom : incidencia : IncidenciaInterna
                deactivate SInc
                deactivate SCom
            end

            SCom --> SF : envio : Envio
            deactivate SCom

            SF -> SAud : registrar(actor, "EMITIR_FACTURA", "Factura", f.id, detalle)
            activate SAud
            SAud --> SF : registro : RegistroAuditoria
            deactivate SAud

            SF --> User : Factura emitida
        end

    else errores no está vacía
        note right of SF
          La factura permanece en estado BORRADOR;
          no consume número de serie ni genera PDF
        end note
        SF --> User : ErrorValidacion(errores)
    end
end

deactivate SF
@enduml