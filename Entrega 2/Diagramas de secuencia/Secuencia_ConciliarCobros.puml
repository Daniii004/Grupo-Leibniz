@startuml Secuencia_ConciliarCobros
title Diagrama de secuencia: Procesar y conciliar cobros entrantes (CU501)

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Temporizador\n(Scheduler)" as Timer <<Sistema>>
participant "plan : Planificador" as Plan <<control>>
participant "sConc : ServicioConciliacion" as SConc <<control>>
participant "pasarela : PasarelaPago" as Pasarela <<interface>>
participant "c : Cobro" as Cobro
participant "f : Factura" as Factura
participant "sNotif : ServicioNotificaciones" as SNotif <<control>>

Timer -> Plan : ejecutarConciliacion()
activate Plan

Plan -> SConc : sincronizarPasarela(desde)
activate SConc

create participant "exec : EjecucionProceso" as Exec
SConc -> Exec : <<create>>("CONCILIACION")

SConc -> Pasarela : obtenerEventos(desde)
activate Pasarela
Pasarela --> SConc : cobros : List<Cobro>
deactivate Pasarela

loop para cada cobro c en cobros
    SConc -> SConc : esDuplicado(c)

    alt no es duplicado
        SConc -> SConc : registrarCobro(c)
        SConc -> SConc : conciliarAutomaticamente(c)
        activate SConc

        alt coincide con factura f (referencia / importe)
            create participant "con : Conciliacion" as Conc
            SConc -> Conc : <<create>>(c, f, importeAplicado, regla)

            SConc -> Factura : actualizarImportePendiente()
            activate Factura
            note right of Factura
              pendiente == 0 -> PAGADA
              pendiente > 0  -> PARCIALMENTE_CONCILIADA
            end note
            Factura --> SConc
            deactivate Factura

            SConc -> Cobro : importeSinAplicar()
            activate Cobro
            Cobro --> SConc : restante : Decimal
            deactivate Cobro

            alt restante == 0
                note right of Cobro : Estado -> CONCILIADO
            else restante > 0 (excedente o aplicación parcial)
                note right of Cobro : Estado -> PARCIALMENTE_APLICADO
                SConc -> SNotif : notificar(responsable, "COBRO_PARCIAL", mensaje)
                activate SNotif
                SNotif --> SConc : notif : Notificacion
                deactivate SNotif
            end

        else sin coincidencia automática
            note right of Cobro : Estado -> PENDIENTE_CONCILIACION
            SConc -> SNotif : notificar(responsable, "COBRO_SIN_CONCILIAR", mensaje)
            activate SNotif
            SNotif --> SConc : notif : Notificacion
            deactivate SNotif
        end

        opt error inesperado al procesar cobro c
            SConc -> Exec : registrarError(c.idExterno, motivo)
            activate Exec
            Exec --> SConc
            deactivate Exec
        end

        deactivate SConc
    else es duplicado
        note right of SConc : Ignorar evento duplicado\n(idExterno ya registrado)
    end
end

note right of Exec
  Cierra ejecución con estado
  COMPLETADO o COMPLETADO_CON_ERRORES
end note
SConc --> Plan : exec : EjecucionProceso
deactivate SConc

deactivate Plan
@enduml