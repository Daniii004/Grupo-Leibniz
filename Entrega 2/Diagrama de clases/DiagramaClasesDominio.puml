}

' =====================================================================
' BLOQUE 4: PRESUPUESTOS, FACTURACIÓN Y CICLO DOCUMENTAL (FR13 - FR20)
' =====================================================================
package "4. Presupuestos y facturación" {

    enum EstadoPresupuesto {
        BORRADOR
        ENVIADO
        ACEPTADO
        RECHAZADO
        FACTURADO
    }

    enum EstadoFactura {
        BORRADOR
        PENDIENTE_APROBACION
        APROBADA
        EMITIDA
        ENVIADA
        EN_DISPUTA
        VENCIDA
        PARCIALMENTE_CONCILIADA
        PAGADA
        ANULADA
        INCOBRABLE
        RECTIFICADA
    }

    ' Las rectificativas no son un tipo: son la subclase FacturaRectificativa.
    enum TipoFactura {
        PUNTUAL
        RECURRENTE
        MIGRADA
    }

    enum TipoPeriodo {
        MENSUAL
        TRIMESTRAL
    }

    enum TipoOperacion {
        FACTURA_CONDICIONES_ESPECIALES
        DESCUENTO_SUPERIOR_UMBRAL
        RECTIFICATIVA
        DEUDA_INCOBRABLE
    }

    enum EstadoAprobacion {
        PENDIENTE
        APROBADA
        RECHAZADA
    }

    abstract class DocumentoComercial {
        # id : Long
        # fechaCreacion : DateTime
        # creadoPor : Usuario
        --
        + agregarLinea(c : Concepto, cantidad : Decimal) : LineaDocumento
        + calcularBaseImponible() : Decimal
        + calcularImpuestos() : Decimal
        + calcularTotal() : Decimal
    }

    ' Copia los datos del concepto: los cambios en el catálogo
    ' no alteran documentos ya creados (FR12.2).
    class LineaDocumento {
        - descripcion : String
        - cantidad : Decimal
        - precioUnitario : Decimal
        - descuento : Decimal
        - porcentajeIVA : Decimal
        --
        + calcularSubtotal() : Decimal
    }

    class Presupuesto {
        - estado : EstadoPresupuesto
        - fechaValidez : Date
        - fechaRespuesta : Date [0..1]
        --
        + aceptar(evidencia : Adjunto) : void
        + rechazar() : void
        + convertirEnFactura() : Factura
    }

    class Factura {
        - numero : String [0..1]
        - fechaEmision : Date [0..1]
        - fechaVencimiento : Date
        - estado : EstadoFactura
        - tipo : TipoFactura
        - importePendiente : Decimal
        - seguimientoPausado : boolean
        - motivoPausa : String [0..1]
        - fechaRevisionPausa : Date [0..1]
        --
        + validar() : List<String>
        + previsualizar() : DocumentoPDF
        + requiereAprobacion() : boolean
        + emitir(serie : SerieFacturacion) : void
        + generarPDF() : DocumentoPDF
        + esEditable() : boolean
        + eliminarBorrador() : void
        + marcarEnDisputa(motivo : String, revision : Date) : void
        + pausarSeguimiento(motivo : String, revision : Date) : void
        + reanudarSeguimiento() : void
        + actualizarImportePendiente() : void
        + rectificar(motivo : String) : FacturaRectificativa
        + solicitarIncobrable(motivo : String) : SolicitudAprobacion
    }

    class FacturaRectificativa {
        - motivo : String
    }

    class SerieFacturacion {
        - prefijo : String
        - anio : int
        - ultimoNumero : int
        - activa : boolean
        --
        + siguienteNumero() : String
    }

    ' Copia inalterable de la factura tal como se emitió (FR18.4).
    class DocumentoPDF {
        - rutaArchivo : String
        - hash : String
        - fechaGeneracion : DateTime
        - destinatarios : List<String>
    }

    class CategoriaProyecto {
        - nombre : String
        - activa : boolean
        --
        + renombrar(nombre : String) : void
    }

    class PeriodoAdministrativo {
        - anio : int
        - numero : int
        - tipo : TipoPeriodo
        - cerrado : boolean
        - fechaCierre : DateTime [0..1]
        - motivoReapertura : String [0..1]
        - cerradoPor : Usuario [0..1]
        --
        + cerrar(u : Usuario) : void
        + reabrir(u : Usuario, motivo : String) : void
        + contiene(fecha : Date) : boolean
    }

    class SolicitudAprobacion {
        - id : Long
        - tipoOperacion : TipoOperacion
        - motivo : String
        - estado : EstadoAprobacion
        - comentarioAprobador : String [0..1]
        - fechaSolicitud : DateTime
        - fechaResolucion : DateTime [0..1]
        - solicitante : Usuario
        - aprobador : Usuario [0..1]
        --
        + aprobar(aprobador : Usuario, comentario : String) : void
        + rechazar(aprobador : Usuario, comentario : String) : void
        + reasignar(nuevoAprobador : Usuario) : void
    }
}

' =====================================================================
' BLOQUE 5: COBROS Y CONCILIACIÓN (FR21 - FR24)
' =====================================================================
package "5. Cobros y conciliación" {

    enum OrigenCobro {
        STRIPE
        REVOLUT
        BANCO
        MANUAL
    }

    enum EstadoCobro {
        PENDIENTE_CONCILIACION
        CONCILIADO
        PARCIALMENTE_APLICADO
        ANULADO
    }

    class Cobro {
        - id : Long
        - idExterno : String {unique}
        - origen : OrigenCobro
        - importe : Decimal
        - referencia : String [0..1]
        - fechaValor : Date
        - estado : EstadoCobro
        --
        + importeSinAplicar() : Decimal
    }

    ' Registra qué movimiento y qué regla o usuario justificó el pago (FR21.4).
    ' Es una clase normal y no de asociación: tras anular una conciliación
    ' (FR22.2) el mismo cobro puede volver a aplicarse a la misma factura.
    class Conciliacion {
        - importeAplicado : Decimal
        - fecha : DateTime
        - reglaAplicada : String [0..1]
        - anulada : boolean
        - motivoAnulacion : String [0..1]
        - realizadaPor : Usuario [0..1]
        - anuladaPor : Usuario [0..1]
        --
        + anular(u : Usuario, motivo : String) : void
    }
}

