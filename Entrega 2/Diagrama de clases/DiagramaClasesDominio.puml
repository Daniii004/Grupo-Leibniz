@startuml DiagramaClasesDominio

title Diagrama de clases (1/2): modelo de dominio - Sistema interno de facturación y cobros de Turbine

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
set namespaceSeparator none
hide empty members
left to right direction

' =====================================================================
' BLOQUE 1: USUARIOS, ROLES Y ASIGNACIONES (FR1, FR2, FR3)
' =====================================================================
package "1. Usuarios, roles y asignaciones" {

    ' Solo identidad y credenciales: las operaciones de los casos de uso
    ' están en los servicios (DiagramaClasesServicios.puml).
    class Usuario {
        - id : Long
        - nombre : String
        - email : String
        - hashContrasena : String
        - activo : boolean
        - fechaAlta : DateTime
        --
        + tienePermiso(codigo : String) : boolean
        + getPermisosEfectivos() : Set<Permiso>
        + asignarRol(r : Rol) : void
        + concederPermiso(p : Permiso) : void
        + retirarPermiso(p : Permiso) : void
        + desactivar() : void
        + cambiarContrasena(actual : String, nueva : String) : void
    }

    ' Los roles son datos, no clases: LECTOR, ADMINISTRADOR y
    ' SUPERADMINISTRADOR son instancias de Rol (FR3).
    class Rol {
        - id : Long
        - nombre : String
        - descripcion : String
        --
        + getPermisosEfectivos() : Set<Permiso>
        + incluye(p : Permiso) : boolean
    }

    class Permiso {
        - codigo : String
        - descripcion : String
    }

    ' Excepción por usuario: concede o retira un permiso
    ' respecto a lo que da su rol (FR1.6, RU-30).
    class PermisoIndividual {
        - concedido : boolean
        - fecha : DateTime
    }

    class Sesion {
        - token : String
        - inicio : DateTime
        - ultimaActividad : DateTime
        - activa : boolean
        --
        + registrarActividad() : void
        + haExpirado(minutosInactividad : int) : boolean
        + cerrar() : void
    }

    class TokenRestablecimiento {
        - token : String
        - fechaCaducidad : DateTime
        - usado : boolean
        --
        + esValido() : boolean
    }

    enum TipoAsignacion {
        PRINCIPAL
        TEMPORAL
    }

    class AsignacionCliente {
        - fechaInicio : Date
        - fechaFin : Date [0..1]
        - tipo : TipoAsignacion
        - activa : boolean
        --
        + estaVigente(fecha : Date) : boolean
        + finalizar() : void
    }
}

note right of Rol
  RBAC jerárquico (FR3): un rol tiene sus permisos
  más los del rol del que hereda (heredaDe).
  - LECTOR: VER_CLIENTES_ASIGNADOS, CREAR_FACTURA,
    CONCILIAR_COBRO, CREAR_INCIDENCIA...
  - ADMINISTRADOR heredaDe LECTOR: VER_TODOS_LOS_CLIENTES,
    ASIGNAR_CLIENTES, APROBAR_SOLICITUDES, CERRAR_PERIODO...
  - SUPERADMINISTRADOR heredaDe ADMINISTRADOR:
    CONFIGURAR_SISTEMA, GESTIONAR_TARIFAS, REABRIR_PERIODO,
    APROBAR_OPERACIONES_CRITICAS...
  Usuario.tienePermiso() mira primero si hay un
  PermisoIndividual y, si no, los permisos efectivos del rol.
  {debe existir al menos un usuario activo con
  rol SUPERADMINISTRADOR} (ACT-01)
end note

' =====================================================================
' BLOQUE 2: CLIENTES Y CONTACTOS (FR4 - FR8)
' =====================================================================
package "2. Clientes y contactos" {

    enum EstadoCliente {
        PENDIENTE_ACTIVACION
        ACTIVO
        PAUSADO
        BAJA_SOLICITADA
        BAJA
        BLOQUEADO
    }

    enum RolContacto {
        COMERCIAL
        ADMINISTRACION
        COBROS
        FACTURACION
        GESTOR_EXTERNO
    }

    enum CanalComunicacion {
        EMAIL
        TELEFONO
        WHATSAPP
    }

    class Cliente {
        - id : Long
        - estado : EstadoCliente
        - moneda : String
        - fechaAlta : Date
        --
        + cambiarEstado(nuevo : EstadoCliente) : void
        + consecuenciasCambioEstado(nuevo : EstadoCliente) : List<String>
        + tieneDatosFiscalesCompletos() : boolean
        + datosFiscalesFaltantes() : List<String>
        + getContactosFacturacion() : List<PersonaContacto>
        + getHistorial() : List<EventoHistorial>
        + fusionarCon(duplicado : Cliente) : void
        + calcularDeudaPendiente() : Decimal
        + getResponsable() : Usuario
    }

    class DatosComerciales {
        - nombre : String
        - sector : String
        - ubicacion : String
        - etiquetas : List<String>
    }

    ' Se reutiliza para los clientes y para la entidad emisora (FR31.1).
    ' Formato no atado al español: sin provincia obligatoria (FR4.2).
    class DatosFiscales {
        - razonSocial : String
        - identificadorFiscal : String
        - domicilio : String
        - codigoPostal : String
        - ciudad : String
        - pais : String
        - idioma : String
        --
        + estanCompletos() : boolean
    }

    class PersonaContacto {
        - id : Long
        - nombre : String
        - email : String
        - telefono : String
        - canales : List<CanalComunicacion>
        - activo : boolean
        --
        + desactivar() : void
    }

    class VinculoContacto {
        - rol : RolContacto
        - activo : boolean
    }

    class EventoHistorial {
        - fecha : DateTime
        - tipo : String
        - descripcion : String
    }

    class ImportacionCSV {
        - nombreArchivo : String
        - mapeoColumnas : Map<String, String>
        - soloFilasValidas : boolean
        - fecha : DateTime
        - ejecutadaPor : Usuario
        --
        + previsualizar() : List<String>
        + detectarNIFDuplicados() : List<String>
        + ejecutar() : InformeImportacion
    }

    class InformeImportacion {
        - importados : int
        - errores : List<String>
    }
}

note bottom of Cliente
  {identificadorFiscal único entre clientes} (FR6.1)
  getResponsable() se deriva de la AsignacionCliente
  vigente (la temporal tiene prioridad sobre la principal).
end note

' =====================================================================
' BLOQUE 3: SUSCRIPCIONES, TARIFAS Y CATÁLOGO (FR9 - FR12, FR15)
' =====================================================================
package "3. Suscripciones, tarifas y catálogo" {

    enum EstadoSuscripcion {
        PENDIENTE_ACTIVACION
        ACTIVA
        PAUSADA
        BAJA
    }

    enum TipoPromocion {
        PRIMER_MES_GRATIS
        COBRO_DESDE_MES_SIGUIENTE
        DESCUENTO_TEMPORAL
    }

    enum EstadoRevision {
        PENDIENTE_DATO
        PENDIENTE_APROBACION
        APROBADA
        RECHAZADA
    }

    class Suscripcion {
        - id : Long
        - plan : String
        - fechaInicio : Date
        - fechaBaja : Date [0..1]
        - cuotaMensual : Decimal
        - plazoPagoDias : int
        - estado : EstadoSuscripcion
        - motivoPausa : String [0..1]
        - fechaReactivacionPrevista : Date [0..1]
        --
        + activar() : void
        + pausar(motivo : String, reactivacion : Date) : void
        + reanudar() : void
        + darDeBaja(fechaEfectiva : Date) : void
        + calcularProrrateo(mes : Date) : Decimal
        + aplicarPromociones(importe : Decimal, mes : Date) : Decimal
        + generarFacturaMensual(mes : Date) : Factura
        + getGestorResponsable() : Usuario
    }

    class LineaSuscripcion {
        - cantidad : int
        - precioPactado : Decimal
    }

    class Promocion {
        - tipo : TipoPromocion
        - porcentaje : Decimal
        - fechaInicio : Date
        - fechaCaducidad : Date [0..1]
        --
        + estaVigente(fecha : Date) : boolean
    }

    class Concepto {
        - id : Long
        - nombre : String
        - descripcion : String
        - precioReferencia : Decimal
        - activo : boolean
    }

    class Impuesto {
        - nombre : String
        - porcentaje : Decimal
    }

    class TablaTarifas {
        - fechaEfecto : Date
        --
        + obtenerRango(facturacionAnual : Decimal) : RangoTarifa
    }

    class RangoTarifa {
        - minimo : Decimal
        - maximo : Decimal [0..1]
        - precio : Decimal
    }

    class RevisionAnual {
        - anio : int
        - facturacionAnual : Decimal [0..1]
        - fuenteDato : String [0..1]
        - fechaDato : Date [0..1]
        - precioAnterior : Decimal
        - precioNuevo : Decimal [0..1]
        - estado : EstadoRevision
