@startuml DiagramaClasesServicios

title Diagrama de clases (2/2): servicios y procesos - Sistema interno de facturación y cobros de Turbine

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
set namespaceSeparator none
hide empty members
left to right direction

' Clases del modelo de dominio que usan los servicios (fondo gris).
' Sus atributos y operaciones están en DiagramaClasesDominio.puml.
' No van en un paquete para que cada una se dibuje junto al servicio que la usa.
class Usuario #DDDDDD
class Rol #DDDDDD
class Permiso #DDDDDD
class Sesion #DDDDDD
class TokenRestablecimiento #DDDDDD
class AsignacionCliente #DDDDDD
class Tarea #DDDDDD
class Cliente #DDDDDD
class ImportacionCSV #DDDDDD
class Suscripcion #DDDDDD
class Concepto #DDDDDD
class TablaTarifas #DDDDDD
class RevisionAnual #DDDDDD
class Presupuesto #DDDDDD
class Factura #DDDDDD
class FacturaRectificativa #DDDDDD
class SerieFacturacion #DDDDDD
class PeriodoAdministrativo #DDDDDD
class SolicitudAprobacion #DDDDDD
class Cobro #DDDDDD
class Conciliacion #DDDDDD
class Plantilla #DDDDDD
class Envio #DDDDDD
class EnvioProgramado #DDDDDD
class Notificacion #DDDDDD
class PreferenciasNotificacion #DDDDDD
class IncidenciaInterna #DDDDDD
class Comentario #DDDDDD
class Adjunto #DDDDDD
class FiltroGuardado #DDDDDD
class AccionMasiva #DDDDDD
class Informe #DDDDDD
class PaqueteGestoria #DDDDDD
class ObjetivoFacturacion #DDDDDD
class TipoCambio #DDDDDD
class InformeProgramado #DDDDDD
class CalendarioLaboral #DDDDDD
class CredencialAPI #DDDDDD
class RegistroAuditoria #DDDDDD
class EjecucionProceso #DDDDDD
class ConfiguracionSistema <<singleton>> #DDDDDD

legend right
  Las clases con fondo gris y sin atributos son del modelo
  de dominio (ver DiagramaClasesDominio.puml).
endlegend

' =====================================================================
' ACCESO, AUTORIZACIÓN Y USUARIOS (FR1, FR2, FR3)
' Componentes: Autenticación y Gestión de Roles
' =====================================================================
package "Acceso, autorización y usuarios" {

    class ServicioAutenticacion <<control>> {
        + iniciarSesion(email : String, contrasena : String) : Sesion
        + cerrarSesion(s : Sesion) : void
        + cerrarSesionesDe(u : Usuario) : void
        + cerrarSesionesInactivas() : int
        + solicitarRestablecimiento(email : String) : TokenRestablecimiento
        + restablecerContrasena(token : String, nueva : String) : void
    }

    ' Punto único de decisión (FR3): los servicios preguntan por
    ' permisos, nunca por roles.
    class ServicioAutorizacion <<control>> {
        + autorizar(actor : Usuario, permiso : String) : void
        + autorizar(actor : Usuario, permiso : String, c : Cliente) : void
        + puedeVerCliente(actor : Usuario, c : Cliente) : boolean
        + clientesVisibles(actor : Usuario) : List<Cliente>
        + verificarSeparacionFunciones(s : SolicitudAprobacion, aprobador : Usuario) : void
    }

    class ServicioUsuarios <<control>> {
        + registrarUsuario(actor : Usuario, nombre : String, email : String, r : Rol) : Usuario
        + desactivarUsuario(actor : Usuario, u : Usuario) : void
        + cambiarRol(actor : Usuario, u : Usuario, r : Rol) : void
        + concederPermiso(actor : Usuario, u : Usuario, p : Permiso) : void
        + retirarPermiso(actor : Usuario, u : Usuario, p : Permiso) : void
        + configurarPreferencias(actor : Usuario, p : PreferenciasNotificacion) : void
    }

    class ServicioAsignaciones <<control>> {
        + asignarCliente(actor : Usuario, c : Cliente, u : Usuario) : AsignacionCliente
        + transferirCliente(actor : Usuario, c : Cliente, destino : Usuario) : void
        + cederTemporalmente(actor : Usuario, c : Cliente, sustituto : Usuario, inicio : Date, fin : Date) : AsignacionCliente
        + devolverCesionesVencidas(fecha : Date) : EjecucionProceso
    }
}

' =====================================================================
' CLIENTES, SUSCRIPCIONES Y CATÁLOGO (FR4 - FR12)
' Componentes: Gestión de Fichas y Contactos, Suscripciones Recurrentes,
' Catálogo y Tarifas
' =====================================================================
package "Clientes, suscripciones y catálogo" {

    class ServicioClientes <<control>> {
        + darDeAlta(actor : Usuario, comerciales : DatosComerciales, fiscales : DatosFiscales) : Cliente
        + modificarFicha(actor : Usuario, c : Cliente, datos : DatosComerciales) : void
        + gestionarContacto(actor : Usuario, c : Cliente, p : PersonaContacto, rol : RolContacto) : void
        + desactivarContacto(actor : Usuario, c : Cliente, p : PersonaContacto) : List<String>
        + cambiarEstado(actor : Usuario, c : Cliente, nuevo : EstadoCliente) : void
        + fusionar(actor : Usuario, original : Cliente, duplicado : Cliente) : void
        + importarCSV(actor : Usuario, archivo : String) : ImportacionCSV
        + consultarHistorial(actor : Usuario, c : Cliente) : List<EventoHistorial>
        + marcarFavorito(actor : Usuario, c : Cliente, favorito : boolean) : void
        + adjuntar(actor : Usuario, c : Cliente, a : Adjunto) : void
    }

    class ServicioSuscripciones <<control>> {
        + crear(actor : Usuario, c : Cliente, inicio : Date, cuota : Decimal) : Suscripcion
        + modificar(actor : Usuario, s : Suscripcion) : void
        + pausar(actor : Usuario, s : Suscripcion, motivo : String, reactivacion : Date) : void
        + reanudar(actor : Usuario, s : Suscripcion) : void
        + darDeBaja(actor : Usuario, s : Suscripcion, fechaEfectiva : Date) : void
        + adjuntarContrato(actor : Usuario, s : Suscripcion, a : Adjunto) : void
        + procesarCambiosProgramados(fecha : Date) : EjecucionProceso
    }

    class ServicioCatalogo <<control>> {
        + gestionarConcepto(actor : Usuario, c : Concepto) : void
        + configurarTablaTarifas(actor : Usuario, t : TablaTarifas) : void
    }

    class ServicioRevisionAnual <<control>> {
        + prepararRevisiones(anio : int) : List<RevisionAnual>
        + registrarFacturacion(actor : Usuario, r : RevisionAnual, importe : Decimal, fuente : String) : void
        + aprobarCambio(actor : Usuario, r : RevisionAnual) : void
        + rechazarCambio(actor : Usuario, r : RevisionAnual) : void
    }
}

' =====================================================================
' FACTURACIÓN Y APROBACIONES (FR13 - FR20)
' Componente: Emisión de Facturas
' =====================================================================
package "Facturación y aprobaciones" {

    class ServicioFacturacion <<control>> {
        + crearPresupuesto(actor : Usuario, c : Cliente) : Presupuesto
        + responderPresupuesto(actor : Usuario, p : Presupuesto, aceptado : boolean, evidencia : Adjunto) : void
        + convertirEnFactura(actor : Usuario, p : Presupuesto) : Factura
        + crearFactura(actor : Usuario, c : Cliente) : Factura
        + previsualizar(actor : Usuario, f : Factura) : DocumentoPDF
        + emitir(actor : Usuario, f : Factura) : void
        + eliminarBorrador(actor : Usuario, f : Factura) : void
        + rectificar(actor : Usuario, f : Factura, motivo : String) : FacturaRectificativa
        + descargarPDF(actor : Usuario, f : Factura) : DocumentoPDF
        + adjuntar(actor : Usuario, f : Factura, a : Adjunto) : void
        + cerrarPeriodo(actor : Usuario, p : PeriodoAdministrativo) : void
        + reabrirPeriodo(actor : Usuario, p : PeriodoAdministrativo, motivo : String) : void
        + importarFacturasAntiguas(actor : Usuario, archivo : String) : int
    }

    class ServicioFacturacionRecurrente <<control>> {
        + generarFacturasMensuales(fecha : Date) : EjecucionProceso
    }

    class ServicioAprobaciones <<control>> {
        + solicitar(actor : Usuario, f : Factura, tipo : TipoOperacion, motivo : String) : SolicitudAprobacion
        + resolver(actor : Usuario, s : SolicitudAprobacion, aprobada : boolean, comentario : String) : void
        + reasignar(actor : Usuario, s : SolicitudAprobacion, nuevo : Usuario) : void
        + bandeja(actor : Usuario) : List<SolicitudAprobacion>
    }
}

' =====================================================================
' COBROS, CONCILIACIÓN Y DEUDA (FR21 - FR24)
' Componentes: Conciliación de Pagos y Gestión de Deuda e Impagos
' =====================================================================
package "Cobros y deuda" {

    interface PasarelaPago {
        + obtenerEventos(desde : DateTime) : List<Cobro>
    }

    class StripeSimulado <<boundary>> {
        + obtenerEventos(desde : DateTime) : List<Cobro>
    }

    class ImportadorMovimientos <<boundary>> {
        + cargar(archivo : String, origen : OrigenCobro) : List<Cobro>
    }

    class ServicioConciliacion <<control>> {
        + registrarCobro(c : Cobro) : void
        + esDuplicado(c : Cobro) : boolean
        + cargarMovimientos(actor : Usuario, archivo : String, origen : OrigenCobro) : List<Cobro>
        + conciliarAutomaticamente(c : Cobro) : Conciliacion [0..1]
        + conciliarManualmente(actor : Usuario, c : Cobro, f : Factura, importe : Decimal) : Conciliacion
        + anular(actor : Usuario, con : Conciliacion, motivo : String) : void
    }

    ' Reglas sobre lo que los clientes deben: vencimientos, disputas,
    ' incobrables y flujo de recordatorios e impagos.
    class ServicioDeuda <<control>> {
        + calcularDeuda(c : Cliente) : EstadoDeuda
        + marcarEnDisputa(actor : Usuario, f : Factura, motivo : String, revision : Date) : void
        + pausarSeguimiento(actor : Usuario, f : Factura, motivo : String, revision : Date) : void
        + reanudarSeguimiento(actor : Usuario, f : Factura) : void
        + solicitarIncobrable(actor : Usuario, f : Factura, motivo : String) : SolicitudAprobacion
        + simularCalendario(actor : Usuario, f : Factura) : List<Date>
        + marcarVencidas(fecha : Date) : EjecucionProceso
        + enviarRecordatoriosPrevios(fecha : Date) : EjecucionProceso
        + enviarAvisosVencimiento(fecha : Date) : EjecucionProceso
        + enviarAvisosImpago(fecha : Date) : EjecucionProceso
        + revisarPausasVencidas(fecha : Date) : void
    }

    class EstadoDeuda <<DTO>> {
        - importePendiente : Decimal
        - importeVencido : Decimal
        - facturasPendientes : List<String>
    }
}

' =====================================================================
' COMUNICACIONES, NOTIFICACIONES E INCIDENCIAS (FR23, FR25 - FR27)
' Componentes: Comunicaciones Externas, Notificaciones Internas e
' Incidencias Internas
' =====================================================================
package "Comunicaciones e incidencias" {

    ' Adaptador del proveedor externo (RNF-11): se puede cambiar de
    ' proveedor o añadir canales sin tocar los servicios.
    interface ProveedorMensajeria {
        + enviar(e : Envio) : boolean
    }

    class CorreoSMTP <<boundary>> {
        + enviar(e : Envio) : boolean
    }

    class WhatsAppAPI <<boundary>> {
        + enviar(e : Envio) : boolean
    }

    ' Modo prueba: simula envíos sin mandar nada al cliente (FR25.4).
    class MensajeriaSimulada <<boundary>> {
        + enviar(e : Envio) : boolean
    }

    class ServicioComunicaciones <<control>> {
        + enviarFactura(f : Factura) : Envio
        + enviarAviso(f : Factura, tipo : TipoPlantilla) : Envio
        + reintentar(e : Envio) : Envio
        + registrarRebote(e : Envio) : IncidenciaInterna
        + simularEnvio(actor : Usuario, f : Factura, tipo : TipoPlantilla) : Envio
        + consultarEnvios(actor : Usuario, f : Factura) : List<Envio>
        + editarPlantilla(actor : Usuario, p : Plantilla, asunto : String, cuerpo : String) : void
        + programarEnvioPeriodico(actor : Usuario, f : Factura, frecuencia : String) : EnvioProgramado
        + enviarProgramados(fecha : Date) : EjecucionProceso
    }

    class ServicioNotificaciones <<control>> {
        + notificar(u : Usuario, tipo : String, mensaje : String) : Notificacion
        + misNotificaciones(actor : Usuario) : List<Notificacion>
        + tareasPendientes(actor : Usuario) : List<Tarea>
        + bandejaGlobal(actor : Usuario) : List<Notificacion>
        + enviarResumenesDiarios() : EjecucionProceso
    }

    class ServicioIncidencias <<control>> {
        + crear(actor : Usuario, titulo : String, descripcion : String, c : Cliente) : IncidenciaInterna
        + crearPorRebote(e : Envio) : IncidenciaInterna
        + comentar(actor : Usuario, i : IncidenciaInterna, texto : String, restringido : boolean) : Comentario
        + adjuntar(actor : Usuario, i : IncidenciaInterna, a : Adjunto) : void
        + cerrar(actor : Usuario, i : IncidenciaInterna, resolucion : String) : void
    }
}

' =====================================================================
' OPERATIVA, INFORMES, CONFIGURACIÓN, API Y PROCESOS (FR28 - FR33)
' Componentes: Reportes y Dashboard, Configuración del Sistema,
' API Gateway Externa, Auditoría y Planificador de Tareas
' =====================================================================
package "Operativa, informes, configuración, API y procesos" {

    class BuscadorGlobal <<control>> {
        + buscarClientes(actor : Usuario, criterios : Map<String, String>) : List<Cliente>
        + buscarFacturas(actor : Usuario, criterios : Map<String, String>) : List<Factura>
        + guardarFiltro(actor : Usuario, nombre : String, criterios : Map<String, String>) : FiltroGuardado
    }

    class PanelFinanciero <<control>> {
        + obtenerMetricas(actor : Usuario, desde : Date, hasta : Date) : MetricasFinancieras
        + desglosar(actor : Usuario, metrica : String) : List<Factura>
        + previsionIngresos(actor : Usuario, mes : Date) : Decimal
        + configurarObjetivo(actor : Usuario, o : ObjetivoFacturacion) : void
    }

    class MetricasFinancieras <<DTO>> {
        - totalFacturado : Decimal
        - totalCobrado : Decimal
        - pendienteCobro : Decimal
        - saldoVencido : Decimal
        - tiempoMedioCobroDias : int
    }

    class ServicioInformes <<control>> {
        + generarInforme(actor : Usuario, filtros : Map<String, String>, formato : FormatoExportacion) : Informe
        + generarPaqueteGestoria(actor : Usuario, p : PeriodoAdministrativo) : PaqueteGestoria
        + programarInforme(actor : Usuario, frecuencia : String, destinatarios : List<Usuario>) : InformeProgramado
        + ejecutarInformesProgramados(fecha : Date) : EjecucionProceso
        + ejecutarAccionMasiva(actor : Usuario, a : AccionMasiva) : String
    }

    ' Dos casos de uso con permisos distintos: los datos del emisor los
    ' modifica el administrador (FR31.1) y los parámetros globales, el
    ' superadministrador (FR31.2).
    class ServicioConfiguracion <<control>> {
        + modificarDatosEmisor(actor : Usuario, datos : DatosFiscales) : void
        + modificarParametros(actor : Usuario, cfg : ConfiguracionSistema) : void
        + gestionarSerie(actor : Usuario, s : SerieFacturacion) : void
        + gestionarFestivos(actor : Usuario, c : CalendarioLaboral) : void
        + consultarEstadoSistema(actor : Usuario) : List<EjecucionProceso>
    }

    class APIDeudas <<boundary>> {
        + consultarDeuda(idCliente : Long, clave : String) : EstadoDeuda
    }

    class ServicioAuditoria <<control>> {
        + registrar(actor : Usuario, accion : String, entidad : String, idEntidad : Long, detalle : String) : RegistroAuditoria
        + consultar(actor : Usuario, filtro : Map<String, String>) : List<RegistroAuditoria>
    }

    ' Actor Temporizador (Scheduler) de los casos de uso.
    class Planificador <<control>> {
        + ejecutarGeneracionMensual() : void
        + ejecutarCambiosDeSuscripciones() : void
        + ejecutarRecordatorios() : void
        + ejecutarEnviosProgramados() : void
        + ejecutarConciliacion() : void
        + ejecutarInformesProgramados() : void
        + ejecutarResumenesDiarios() : void
        + revisarAsignacionesTemporales() : void
        + cerrarSesionesInactivas() : void
        + prepararRevisionesAnuales() : void
    }
}

note as NotaAutorizacion
  Toda operación que recibe un actor : Usuario llama primero
  a ServicioAutorizacion.autorizar(actor, PERMISO) y, si cambia
  datos, a ServicioAuditoria.registrar(...). Los servicios no
  conocen los roles: solo los permisos (FR3, RNF-07, RNF-08).
  Por legibilidad solo se dibujan las dependencias hacia
  ServicioAutorizacion. Las operaciones sin actor las lanza
  el Planificador o las invoca otro servicio.
end note

