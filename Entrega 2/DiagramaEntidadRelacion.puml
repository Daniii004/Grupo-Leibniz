@startuml
skinparam linetype ortho
'https://plantuml.com/class-diagram
'PRUEBA
hide circle
entity "Usuario" as usuario {
    * id : INT <<PK>>
    --
    * rol : VARCHAR(11)

}
entity "AsignacionDeCliente" as AsignacionDeCliente {
    * id : INT <<PK>>
    --
    * idUsuario : INT <<FK>>
    * idCliente : INT <<FK>>
}
entity "Cliente" as cliente {
    * id : INT <<PK>>
    --
    * correo : VARCHAR(70)
    * eliminado : BOOL
}

usuario ||---o{AsignacionDeCliente : Tiene Asignado >
AsignacionDeCliente}o---|| cliente : Está asignado a <

entity "IncidenciaInterna" as incidenciaInterna{
    * id : INT <<PK>>
    --
    * textoIncidencia : VARCHAR(500)
    * idUsuario : INT <<FK>>
}
entity "Comentario" as comentario{
    * id : INT <<PK>>
    --
    * idUsuario : INT <<FK>>
    * idIncidencia : INT <<FK>>
    * texto : VARCHAR(500)
}
usuario ||--right--o{ comentario : realiza >
usuario ||--o{ incidenciaInterna : pone >
comentario }o--|| incidenciaInterna : pertenece a >
@enduml