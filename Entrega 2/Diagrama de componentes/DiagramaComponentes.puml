@startuml

title Diagrama de Componentes - Turbine

skinparam shadowing false
skinparam defaultFontSize 13
skinparam nodesep 45
skinparam ranksep 70
skinparam component {
    BackgroundColor #F8FAFC
    BorderColor #334155
}
skinparam package {
    BorderColor #64748B
    FontSize 14
}

' Las conexiones se colorean por tipo para poder seguirlas (ver la leyenda):
'   azul    -> peticiones de la capa de presentación
'   negro   -> dependencias entre componentes de negocio
'   morado  -> procesos automáticos lanzados por el Planificador
'   verde   -> servicios externos
'   gris    -> persistencia (IDatabase, IArchivos)

package "Capa de Presentación" {
    [Aplicación Web] as web
    [Sistema Brain (Externo)] as brain
}

package "Módulo de Accesos" {
    [Autenticación] as auth
    [Gestión de Roles] as roles
}

package "Módulo de Clientes" {
    [Gestión de Fichas y Contactos] as clientes
}

package "Módulo Comercial" {
    [Catálogo y Tarifas] as tarifas
    [Suscripciones Recurrentes] as suscripciones
}

package "Módulo de Facturación" {
    [Emisión de Facturas] as facturas
}

package "Módulo de Cobros" {
    [Conciliación de Pagos] as cobros
    [Gestión de Deuda e Impagos] as deuda
}

package "Módulo de Soporte" {
    [Comunicaciones Externas] as comunicacion
    [Notificaciones Internas] as notificaciones
    [Incidencias Internas] as incidencias
}

package "Módulo de Control" {
    [Reportes y Dashboard] as reportes
    [API Gateway Externa] as api
    [Configuración del Sistema] as config
    [Auditoría] as auditoria
    [Planificador de Tareas] as planificador
}

package "Persistencia" {
    [Base de Datos] as db
    [Almacenamiento de Archivos] as files
}

package "Servicios Externos" {
    [Pasarela de pago] as stripe
    [Email / WhatsApp] as mail
}

' --- Conexiones de Frontend ---
web -(0- auth #line:2563EB;text:2563EB : IAuth
web -(0- roles #line:2563EB;text:2563EB : IRoles
web -(0- clientes #line:2563EB;text:2563EB : IClientes
web -(0- tarifas #line:2563EB;text:2563EB : ITarifas
web -(0- facturas #line:2563EB;text:2563EB : IFacturas
web -(0- suscripciones #line:2563EB;text:2563EB : ISuscripciones
web -(0- cobros #line:2563EB;text:2563EB : ICobros
web -(0- deuda #line:2563EB;text:2563EB : IDeuda
web -(0- comunicacion #line:2563EB;text:2563EB : IComunicacion
web -(0- notificaciones #line:2563EB;text:2563EB : INotificaciones
web -(0- incidencias #line:2563EB;text:2563EB : IIncidencias
web -(0- reportes #line:2563EB;text:2563EB : IReportes
web -(0- config #line:2563EB;text:2563EB : IConfiguracion
web -(0- auditoria #line:2563EB;text:2563EB : IAuditoria

' --- Conexiones de la API ---
brain -(0- api #line:2563EB;text:2563EB : IConsultaAPI
api -(0- deuda : IDeuda

' --- Conexiones Internas de Negocio ---
' Seguridad: la autenticación identifica al usuario y Gestión de Roles
' decide qué puede hacer (ver la nota de interfaces transversales)
auth -(0- roles : IRoles
roles -(0- clientes : IClientes

' Comercial
suscripciones -(0- tarifas : ITarifas
suscripciones -(0- clientes : IClientes

' Facturación
facturas -(0- clientes : IClientes
facturas -(0- suscripciones : ISuscripciones
facturas -(0- tarifas : ITarifas

' Cobros y Deuda
cobros -(0- facturas : IFacturas
deuda -(0- cobros : ICobros
deuda -(0- facturas : IFacturas

' Comunicaciones con el cliente
facturas -(0- comunicacion : IComunicacion
deuda -(0- comunicacion : IComunicacion
' Un rebote de correo abre una incidencia interna (FR25.3)
comunicacion -(0- incidencias : IIncidencias
' Para saber a qué contacto de facturación del cliente se envía cada mensaje
comunicacion -(0- clientes : IClientes

' Avisos internos a los empleados (FR26)
facturas -(0- notificaciones : INotificaciones
suscripciones -(0- notificaciones : INotificaciones
cobros -(0- notificaciones : INotificaciones
deuda -(0- notificaciones : INotificaciones
incidencias -(0- notificaciones : INotificaciones
notificaciones -(0- comunicacion : IComunicacion

' Procesos automáticos en segundo plano (FR33, actor Temporizador)
planificador -(0- auth #line:9333EA;text:9333EA : IAuth
planificador -(0- roles #line:9333EA;text:9333EA : IRoles
planificador -(0- tarifas #line:9333EA;text:9333EA : ITarifas
planificador -(0- suscripciones #line:9333EA;text:9333EA : ISuscripciones
planificador -(0- facturas #line:9333EA;text:9333EA : IFacturas
planificador -(0- cobros #line:9333EA;text:9333EA : ICobros
planificador -(0- deuda #line:9333EA;text:9333EA : IDeuda
planificador -(0- comunicacion #line:9333EA;text:9333EA : IComunicacion
planificador -(0- reportes #line:9333EA;text:9333EA : IReportes

' --- Conexiones a Persistencia ---
auth -(0- db #line:B8B8B8;text:999999 : IDatabase
roles -(0- db #line:B8B8B8;text:999999 : IDatabase
clientes -(0- db #line:B8B8B8;text:999999 : IDatabase
tarifas -(0- db #line:B8B8B8;text:999999 : IDatabase
suscripciones -(0- db #line:B8B8B8;text:999999 : IDatabase
facturas -(0- db #line:B8B8B8;text:999999 : IDatabase
cobros -(0- db #line:B8B8B8;text:999999 : IDatabase
deuda -(0- db #line:B8B8B8;text:999999 : IDatabase
comunicacion -(0- db #line:B8B8B8;text:999999 : IDatabase
notificaciones -(0- db #line:B8B8B8;text:999999 : IDatabase
incidencias -(0- db #line:B8B8B8;text:999999 : IDatabase
reportes -(0- db #line:B8B8B8;text:999999 : IDatabase
api -(0- db #line:B8B8B8;text:999999 : IDatabase
config -(0- db #line:B8B8B8;text:999999 : IDatabase
auditoria -(0- db #line:B8B8B8;text:999999 : IDatabase
planificador -(0- db #line:B8B8B8;text:999999 : IDatabase

clientes -(0- files #line:B8B8B8;text:999999 : IArchivos
suscripciones -(0- files #line:B8B8B8;text:999999 : IArchivos
facturas -(0- files #line:B8B8B8;text:999999 : IArchivos
incidencias -(0- files #line:B8B8B8;text:999999 : IArchivos
reportes -(0- files #line:B8B8B8;text:999999 : IArchivos

' --- Conexiones a Servicios Externos ---
cobros -(0- stripe #line:15803D;text:15803D : IPagos
comunicacion -(0- mail #line:15803D;text:15803D : IMensajeriaExterna

note as NotaTransversales
  <b>Interfaces transversales</b>
  Por legibilidad no se dibuja una conexión por componente:
  * <b>IRoles</b>: todos los componentes de negocio comprueban
    el permiso del usuario antes de actuar (FR3, RNF-07).
  * <b>IAuditoria</b>: todos los componentes que modifican datos
    sensibles registran la operación (RNF-08).
  * <b>IConfiguracion</b>: Autenticación, Emisión de Facturas y
    Gestión de Deuda leen plazos, umbrales y dominio (FR31.2).
end note

legend right
  <b>Color de las conexiones</b>
  <color:#2563EB><b>━━</b></color>  Peticiones de la capa de presentación
  <color:#000000><b>━━</b></color>  Dependencias entre componentes de negocio
  <color:#9333EA><b>━━</b></color>  Procesos automáticos (Planificador de Tareas)
  <color:#15803D><b>━━</b></color>  Servicios externos
  <color:#B8B8B8><b>━━</b></color>  Persistencia (IDatabase, IArchivos)
endlegend

@enduml
