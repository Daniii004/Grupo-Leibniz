@startuml
package "Interfaz de Usuario" {
    [Aplicación Web] as web
}

package "Gestión de Accesos" {
    [Autenticación y Roles] as auth
}

package "Lógica de Negocio" {
    [Gestión de Clientes] as clientes
    [Facturación y Suscripciones] as fact
    [Cobros y Conciliación] as cobros
    [Comunicaciones] as notif
    [Dashboard y Reportes] as reportes
}

package "Persistencia" {
    [Base de Datos] as database
    [Almacenamiento PDFs] as files
}

package "Servicios Externos" {
    [Pasarela Stripe] as stripe
}

' Conexiones desde la interfaz web a los módulos del backend
web -(0- auth : IAuth
web -(0- clientes : IClientes
web -(0- fact : IFacturacion
web -(0- cobros : ICobros
web -(0- reportes : IReportes

' Conexiones internas de lógica de negocio
fact -(0- clientes : IClientes
cobros -(0- fact : IFacturacion
fact -(0- notif : INotificaciones
cobros -(0- notif : INotificaciones

' Conexiones a servicios externos
cobros -(0- stripe : IPagosStripe

' Conexiones a persistencia (Base de Datos)
auth -(0- database : IDatabase
clientes -(0- database : IDatabase
fact -(0- database : IDatabase
cobros -(0- database : IDatabase
reportes -(0- database : IDatabase
notif -(0- database : IDatabase

' Conexiones a persistencia (Archivos)
fact -(0- files : IArchivos
@enduml